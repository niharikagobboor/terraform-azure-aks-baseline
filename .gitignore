# Terraform local execution cache & plugins
**/.terraform/*
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash logs
crash.log
crash.*.log

# Exclude sensitive tfvars files (allow example template)
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Speculative plan output files
*.tfplan
*.plan

# OS and IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
