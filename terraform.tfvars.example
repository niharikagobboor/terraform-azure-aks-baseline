resource_group_name = "rg-aks-prod-useast2"
location            = "eastus2"

# Network
vnet_name                   = "vnet-aks-prod-useast2"
vnet_address_space          = ["10.20.0.0/16"]
aks_subnet_name             = "snet-aks-prod-nodes"
aks_subnet_address_prefixes = ["10.20.1.0/24"]

# Observability
log_analytics_workspace_name    = "law-aks-prod-useast2"
log_analytics_workspace_sku     = "PerGB2018"
log_analytics_retention_in_days = 60

# Cluster
cluster_name                    = "aks-prod-useast2"
dns_prefix                      = "aks-prod-useast2"
kubernetes_version              = "1.30"
sku_tier                        = "Standard"
api_server_authorized_ip_ranges = ["198.51.100.0/24", "203.0.113.50/32"]

# System node pool
default_node_pool_name                 = "system"
default_node_pool_vm_size              = "Standard_D4s_v5"
default_node_pool_os_sku               = "AzureLinux"
default_node_pool_os_disk_size_gb      = 128
default_node_pool_node_count           = 3
default_node_pool_min_count            = 3
default_node_pool_max_count            = 6
default_node_pool_critical_addons_only = false
availability_zones                     = ["1", "2", "3"]

# Addons
key_vault_secret_rotation_enabled  = true
key_vault_secret_rotation_interval = "2m"

# Internal networking
network_service_cidr   = "172.16.0.0/16"
network_dns_service_ip = "172.16.0.10"

# User node pool
enable_user_node_pool    = false
user_node_pool_name      = "workload"
user_node_pool_vm_size   = "Standard_D4s_v5"
user_node_pool_min_count = 1
user_node_pool_max_count = 5

# Tags
tags = {
  Environment = "Production"
  ManagedBy   = "Terraform"
  Project     = "aks-baseline"
  Owner       = "PlatformEngineering"
}
